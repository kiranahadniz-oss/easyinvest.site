<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Wallet — Easy Invest</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 min-h-screen text-slate-800">
    <header class="bg-white shadow">
      <div class="max-w-6xl mx-auto p-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <img src="/logo.svg" class="w-10 h-10" />
          <h1 class="text-xl font-bold">Wallet</h1>
        </div>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-sm text-indigo-600">Dashboard</a>
          <a href="/logout" class="text-sm text-red-600">Logout</a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-6">
      <div class="bg-white p-4 rounded shadow">
        <h2 class="font-semibold">Balance</h2>
        <div class="text-2xl font-bold mt-2">RS <%= user.wallet %></div>
      </div>

      <div class="grid md:grid-cols-2 gap-4 mt-6">
        <div class="bg-white p-4 rounded shadow">
          <h3 class="font-semibold">Deposits</h3>
          <ul class="mt-2 space-y-2 text-sm">
            <% deposits.forEach(function(d){ %>
              <li class="border-b py-2"><div class="flex justify-between"><div><%= d.method %> — RS <%= d.amount %></div><div class="text-slate-500"><%= new Date(d.created_at).toLocaleString() %></div></div></li>
            <% }) %>
            <% if (!deposits.length) { %><li class="text-slate-500">No deposits yet</li><% } %>
          </ul>
        </div>

        <div class="bg-white p-4 rounded shadow">
          <h3 class="font-semibold">Withdrawals</h3>
          <ul class="mt-2 space-y-2 text-sm">
            <% withdraws.forEach(function(w){ %>
              <li class="border-b py-2"><div class="flex justify-between"><div>RS <%= w.amount %> — <%= w.status %></div><div class="text-slate-500"><%= new Date(w.created_at).toLocaleString() %></div></div></li>
            <% }) %>
            <% if (!withdraws.length) { %><li class="text-slate-500">No withdrawals yet</li><% } %>
          </ul>
        </div>
      </div>
    </main>
  </body>
</html>
