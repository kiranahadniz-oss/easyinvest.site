<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Packages — Easy Invest</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 min-h-screen text-slate-800">
    <header class="bg-white shadow">
      <div class="max-w-6xl mx-auto p-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <img src="/logo.svg" class="w-10 h-10" />
          <h1 class="text-xl font-bold">Packages</h1>
        </div>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-sm text-indigo-600">Dashboard</a>
          <a href="/logout" class="text-sm text-red-600">Logout</a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <% packages.forEach(function(p){ %>
          <div class="bg-white p-4 rounded shadow flex flex-col justify-between">
            <div>
              <div class="text-slate-500">Package</div>
              <div class="text-2xl font-bold mt-2">RS <%= p %></div>
            </div>
            <form method="post" action="/subscribe" class="mt-4">
              <input type="hidden" name="price" value="<%= p %>" />
              <button class="w-full bg-indigo-600 text-white px-3 py-2 rounded">Subscribe</button>
            </form>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
