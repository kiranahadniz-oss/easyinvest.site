<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Easy Invest — Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 min-h-screen text-slate-800">
    <header class="bg-white shadow">
      <div class="max-w-6xl mx-auto p-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <img src="/logo.svg" class="w-10 h-10" />
          <h1 class="text-xl font-bold">Easy Invest</h1>
        </div>
        <div class="flex items-center gap-3">
          <div class="p-2 rounded bg-white shadow text-sm">Wallet: RS <%= user.wallet %></div>
          <a href="/logout" class="text-sm text-red-600">Logout</a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
      <section class="md:col-span-1 bg-white p-4 rounded shadow">
        <h2 class="font-semibold">Profile</h2>
        <p class="text-sm text-slate-500">Welcome, <%= user.fullname %> (<%= user.username %>)</p>
        <form action="/profile/update" method="post" class="mt-3 space-y-2">
          <input name="username" value="<%= user.username %>" class="w-full p-2 border rounded" />
          <input name="email" value="<%= user.email %>" class="w-full p-2 border rounded" />
          <button class="bg-indigo-500 px-3 py-2 text-white rounded">Update profile</button>
        </form>
        <div class="mt-4 text-sm">
          <p>Referral link:</p>
          <div class="flex gap-2 items-center mt-2">
            <input id="refLink" class="flex-1 p-2 border rounded" value="https://easyinvest.site/refer/<%= user.ref_code %>" readonly />
            <button id="copyBtn" class="px-3 py-2 bg-indigo-500 text-white rounded">Copy</button>
          </div>
          <p class="mt-2 text-slate-500">Invite friends and earn referral bonuses.</p>
        </div>
      </section>

      <section class="md:col-span-2 bg-white p-4 rounded shadow">
        <h2 class="font-semibold">Investments & Actions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="p-4 border rounded">
            <h3 class="font-semibold">Subscribe to a package</h3>
            <div class="mt-3 grid grid-cols-2 gap-2">
              <% packages.forEach(function(p){ %>
                <form method="post" action="/subscribe" class="p-2 border rounded">
                  <input type="hidden" name="price" value="<%= p %>" />
                  <div class="font-bold">RS <%= p %></div>
                  <button class="mt-2 bg-indigo-500 text-white px-3 py-1 rounded">Subscribe</button>
                </form>
              <% }) %>
            </div>
          </div>

          <div class="p-4 border rounded">
            <h3 class="font-semibold">Deposit</h3>
            <form action="/deposit" method="post" enctype="multipart/form-data" class="space-y-2 mt-2">
              <select name="method" class="w-full p-2 border rounded">
                <option value="jazzcash">JazzCash</option>
                <option value="easypaisa">Easypaisa</option>
                <option value="bank">Bank Deposit</option>
              </select>
              <input name="amount" placeholder="Amount" class="w-full p-2 border rounded" />
              <input name="account" placeholder="Account number" class="w-full p-2 border rounded" />
              <input name="transaction_id" placeholder="Transaction ID" class="w-full p-2 border rounded" />
              <input type="file" name="slip" />
              <button class="bg-emerald-500 px-3 py-1 rounded text-white">Create deposit (pending)</button>
            </form>

            <h3 class="mt-4 font-semibold">Withdraw</h3>
            <form action="/withdraw" method="post" class="space-y-2 mt-2">
              <input name="amount" placeholder="Amount" class="w-full p-2 border rounded" />
              <input name="account" placeholder="Receive account info" class="w-full p-2 border rounded" />
              <button class="bg-red-500 px-3 py-1 rounded text-white">Request withdraw</button>
            </form>
          </div>
        </div>

        <div class="mt-6">
          <h3 class="font-semibold">Subscriptions</h3>
          <table class="w-full mt-2 border-collapse">
            <thead>
              <tr class="text-left text-slate-500"><th>Package</th><th>Started</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
              <% subs.forEach(function(s){ %>
                <tr class="border-t"><td>RS <%= s.price %></td><td><%= new Date(s.started_at).toLocaleString() %></td><td><%= s.active ? 'Active' : 'Inactive' %></td><td>
                  <% if (!s.refund_requested) { %>
                    <form method="post" action="/refund"><input type="hidden" name="subscription_id" value="<%= s.id %>" /><button class="text-sm text-red-600">Request refund</button></form>
                  <% } else { %>
                    <span class="text-sm text-slate-500">Refund requested</span>
                  <% } %>
                </td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-4 border rounded">
            <div class="text-sm text-slate-500">Pending deposits</div>
            <div class="font-bold mt-2"><%= deposits.filter(d=>d.status==='pending').length %></div>
          </div>
          <div class="p-4 border rounded">
            <div class="text-sm text-slate-500">Pending withdraws</div>
            <div class="font-bold mt-2"><%= withdraws.filter(w=>w.status==='pending').length %></div>
          </div>
          <div class="p-4 border rounded">
            <div class="text-sm text-slate-500">Total referrals</div>
            <div class="font-bold mt-2"><%= referrals.length %></div>
          </div>
        </div>

      </section>
    </main>

    <script>
      document.getElementById('copyBtn')?.addEventListener('click', function(){
        const input = document.getElementById('refLink');
        if (!input) return;
        input.select();
        input.setSelectionRange(0, 99999);
        navigator.clipboard?.writeText(input.value).then(()=>{
          const orig = this.textContent;
          this.textContent = 'Copied';
          setTimeout(()=> this.textContent = orig, 2000);
        }).catch(()=>{
          alert('Copy failed — manual copy: ' + input.value);
        });
      });
    </script>
  </body>
</html>
