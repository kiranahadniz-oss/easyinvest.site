<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Easy Invest — Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 min-h-screen text-slate-800">
    <header class="bg-white shadow">
      <div class="max-w-6xl mx-auto p-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <img src="/logo.svg" class="w-10 h-10" />
          <h1 class="text-xl font-bold">Easy Invest Admin</h1>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-6">
      <h2 class="font-semibold">Pending Deposits</h2>
      <div class="mt-3 grid gap-3">
        <% deposits.forEach(function(d){ %>
          <div class="p-3 bg-white rounded shadow flex justify-between">
            <div><strong><%= d.username %></strong> deposited RS <%= d.amount %> via <%= d.method %></div>
            <form method="post" action="/admin/deposit/approve"><input type="hidden" name="id" value="<%= d.id %>" /><button class="bg-emerald-500 px-3 py-1 text-white rounded">Approve</button></form>
          </div>
        <% }) %>
      </div>

      <h2 class="mt-6 font-semibold">Pending Withdraws</h2>
      <div class="mt-3 grid gap-3">
        <% withdraws.forEach(function(w){ %>
          <div class="p-3 bg-white rounded shadow flex justify-between">
            <div><strong><%= w.username %></strong> requested RS <%= w.amount %></div>
            <form method="post" action="/admin/withdraw/approve"><input type="hidden" name="id" value="<%= w.id %>" /><button class="bg-red-500 px-3 py-1 text-white rounded">Approve</button></form>
          </div>
        <% }) %>
      </div>

      <h2 class="mt-6 font-semibold">Pending Refunds</h2>
      <div class="mt-3 grid gap-3">
        <% refunds.forEach(function(r){ %>
          <div class="p-3 bg-white rounded shadow flex justify-between items-center">
            <div>
              <strong><%= r.username %></strong> requested refund for package RS <%= r.price %> — Requested at <%= new Date(r.refund_requested_at).toLocaleString() %>
            </div>
            <form method="post" action="/admin/refund/approve"><input type="hidden" name="id" value="<%= r.id %>" /><button class="bg-yellow-500 px-3 py-1 text-white rounded">Approve Refund</button></form>
          </div>
        <% }) %>
      </div>

    </main>
  </body>
</html>
