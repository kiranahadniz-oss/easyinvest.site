<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Profile — Easy Invest</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 min-h-screen text-slate-800">
    <header class="bg-white shadow">
      <div class="max-w-6xl mx-auto p-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <img src="/logo.svg" class="w-10 h-10" />
          <h1 class="text-xl font-bold">Profile</h1>
        </div>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-sm text-indigo-600">Dashboard</a>
          <a href="/logout" class="text-sm text-red-600">Logout</a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
      <section class="md:col-span-1 bg-white p-4 rounded shadow">
        <h2 class="font-semibold">Profile</h2>
        <p class="text-sm text-slate-500">Welcome, <%= user.fullname %> (<%= user.username %>)</p>
        <form action="/profile/update" method="post" class="mt-3 space-y-2">
          <input name="username" value="<%= user.username %>" class="w-full p-2 border rounded" />
          <input name="email" value="<%= user.email %>" class="w-full p-2 border rounded" />
          <button class="bg-indigo-500 px-3 py-2 text-white rounded">Update profile</button>
        </form>

        <div class="mt-4 text-sm">
          <p>Referral link:</p>
          <div class="flex gap-2 items-center mt-2">
            <input id="refLink" class="flex-1 p-2 border rounded" value="<%= (req.hostname ? (req.protocol + '://' + req.hostname) : 'https://easyinvest.site') + '/refer/' + user.ref_code %>" readonly />
            <button id="copyBtn" class="px-3 py-2 bg-indigo-500 text-white rounded">Copy</button>
          </div>
        </div>
      </section>

      <section class="md:col-span-2 bg-white p-4 rounded shadow">
        <h2 class="font-semibold">Change password</h2>
        <% if (msg) { %>
          <div class="p-2 mt-2 rounded bg-emerald-100 text-emerald-800"><%= msg %></div>
        <% } %>
        <form action="/profile/password" method="post" class="mt-3 space-y-3 max-w-md">
          <input name="currentPassword" type="password" placeholder="Current password" class="w-full p-2 border rounded" />
          <input name="newPassword" type="password" placeholder="New password" class="w-full p-2 border rounded" />
          <input name="confirmPassword" type="password" placeholder="Confirm new password" class="w-full p-2 border rounded" />
          <div>
            <button class="bg-emerald-500 px-3 py-2 text-white rounded">Update password</button>
          </div>
        </form>
      </section>
    </main>

    <script>
      document.getElementById('copyBtn')?.addEventListener('click', function(){
        const input = document.getElementById('refLink');
        if (!input) return;
        navigator.clipboard?.writeText(input.value).then(()=>{
          const orig = this.textContent;
          this.textContent = 'Copied';
          setTimeout(()=> this.textContent = orig, 2000);
        }).catch(()=> alert('Copy failed — manual copy: ' + input.value));
      });
    </script>
  </body>
</html>
