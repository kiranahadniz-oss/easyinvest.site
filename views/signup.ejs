<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Easy Invest — Sign up</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gradient-to-br from-indigo-900 via-slate-800 to-slate-700 min-h-screen flex items-center justify-center text-slate-100">
    <div class="max-w-md w-full p-8 bg-white/5 rounded-2xl shadow-lg">
      <div class="flex items-center gap-3 mb-6">
        <img src="/logo.svg" alt="Easy Invest" class="w-12 h-12" />
        <h1 class="text-2xl font-bold">Create an account</h1>
      </div>

      <% if (error) { %>
        <div class="bg-red-600/30 p-3 rounded mb-4"><%= error %></div>
      <% } %>

      <form method="post" action="/signup" class="space-y-4">
        <input name="fullname" placeholder="Full name" class="w-full p-3 rounded bg-white/5" />
        <input name="username" placeholder="Username" class="w-full p-3 rounded bg-white/5" />
        <input name="email" placeholder="Email" class="w-full p-3 rounded bg-white/5" />
        <input name="phone" placeholder="Phone number" class="w-full p-3 rounded bg-white/5" />
        <input name="password" type="password" placeholder="Password" class="w-full p-3 rounded bg-white/5" />
        <input name="password2" type="password" placeholder="Verify password" class="w-full p-3 rounded bg-white/5" />
        <input name="ref" placeholder="Referral code (optional)" class="w-full p-3 rounded bg-white/5" />
        <div class="flex justify-between items-center text-sm">
          <a href="/" class="text-indigo-300">Already have an account? Login</a>
          <button class="bg-emerald-500 hover:bg-emerald-600 px-4 py-2 rounded">Sign up</button>
        </div>
      </form>
    </div>
  </body>
</html>
